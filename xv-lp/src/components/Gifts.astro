---
import type { EventData } from '../types/event';

interface Props { data: EventData; }
const { data } = Astro.props;
---

<section id="regalos" class="section-pad reveal text-center" aria-labelledby="gifts-title">
  <p class="eyebrow">{data.gifts.title}</p>
  <h2 id="gifts-title" class="script-title mt-4">Un detallito</h2>
  <p class="mx-auto mt-6 max-w-md text-sm leading-relaxed text-ink/65">{data.gifts.text}</p>
  <button
    type="button"
    id="copy-alias"
    class="btn-ghost mt-8 normal-case tracking-[0.12em]"
    data-alias={data.gifts.alias}
    data-copied={data.gifts.copied}
  >
    {data.gifts.alias}
  </button>
  <p class="mt-3 text-[0.65rem] tracking-wide text-ink/40">{data.gifts.copy}</p>
</section>
