---
import type { EventData } from '../types/event';

interface Props { data: EventData; }
const { data } = Astro.props;
---

<section id="dress" class="section-pad reveal text-center" aria-labelledby="dress-title">
  <p class="eyebrow">{data.dressCode.title}</p>
  <div class="mt-4 flex items-center justify-center gap-3 sm:gap-5">
    <svg class="dress-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true">
      <path d="M48 20c-8 1-18 10-24 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      <path d="M48 20c4 0 6 2 6 5s-3 6-8 6c-4 0-9 2-14 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M24 42v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      <path d="M16 54h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
    <h2 id="dress-title" class="script-title shrink-0">{data.dressCode.label}</h2>
    <svg class="dress-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true">
      <path d="M8 22 26 32 8 42Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round"></path>
      <path d="M56 22 38 32 56 42Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round"></path>
      <rect x="26" y="26" width="12" height="12" rx="1.5" stroke="currentColor" stroke-width="1.45"></rect>
      <path d="M32 20v6M32 38v6" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"></path>
    </svg>
  </div>
  <p class="mx-auto mt-8 max-w-sm text-sm leading-relaxed text-ink/65">{data.dressCode.text}</p>
</section>

<style>
  .dress-icon {
    width: 36px;
    height: 36px;
    flex: none;
    color: #1a1a1a;
    opacity: 0.7;
  }

  @media (min-width: 640px) {
    .dress-icon {
      width: 42px;
      height: 42px;
    }
  }
</style>
