---
import type { EventData } from '../types/event';

interface Props { data: EventData; }
const { data } = Astro.props;
---

<footer class="on-ink px-5 py-12 text-center">
  <p class="font-script text-3xl text-white">{data.honoree}</p>
  <p class="mt-3 text-sm text-silver">{data.footer.thanks}</p>
  <p class="mt-6 text-xs tracking-[0.25em] text-white/40">{data.hashtag}</p>
</footer>
