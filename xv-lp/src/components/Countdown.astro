---
import type { EventData } from '../types/event';

interface Props { data: EventData; }
const { data } = Astro.props;
const units = [
  { id: 'days', label: data.countdown.days },
  { id: 'hours', label: data.countdown.hours },
  { id: 'minutes', label: data.countdown.minutes },
  { id: 'seconds', label: data.countdown.seconds },
] as const;
---

<section id="countdown" class="section-pad reveal text-center" aria-labelledby="countdown-title">
  <h2 id="countdown-title" class="eyebrow">{data.countdown.title}</h2>
  <div
    id="countdown-timer"
    class="count-grid"
    data-event-date={data.eventDate}
    role="timer"
  >
    {
      units.map((unit) => (
        <div class="count-tile">
          <span class="count-spark" aria-hidden="true"></span>
          <p id={`cd-${unit.id}`} class="count-num">00</p>
          <p class="count-label">{unit.label}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .count-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    max-width: 520px;
    margin: 1.75rem auto 0;
  }

  .count-tile {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    padding: 1.35rem 0.3rem 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background:
      radial-gradient(120% 80% at 20% 0%, rgba(255, 255, 255, 0.2), transparent 42%),
      repeating-linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.045) 0 7px,
        transparent 7px 14px
      ),
      #111;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
  }

  .count-spark {
    display: block;
    width: 7px;
    height: 7px;
    margin: 0 auto 0.65rem;
    background: #e8e4dc;
    clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
    opacity: 0.7;
  }

  .count-num {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(1.7rem, 6.4vw, 2.7rem);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: #f4f2ef;
  }

  .count-label {
    margin: 0.55rem 0 0;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(232, 228, 220, 0.55);
  }

  @media (max-width: 400px) {
    .count-grid {
      gap: 8px;
    }

    .count-tile {
      padding-block: 1.05rem 0.8rem;
    }
  }
</style>
